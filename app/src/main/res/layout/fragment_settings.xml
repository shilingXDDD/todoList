<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

        <!-- ==================== 用户信息卡片 ==================== -->
        <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                <!-- 圆形头像 -->
                <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_avatar">

                    <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/settings_nickname_label"
                            android:src="@drawable/ic_person" />

                </FrameLayout>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <!-- 欢迎语（昵称） -->
                    <TextView
                            android:id="@+id/txv_welcome"
                            style="@style/TextAppearance.App.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="你好，小明" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/settings_user_subtitle"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 功能模块 ==================== -->
        <TextView
                style="@style/TextAppearance.App.GroupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_group_function" />

        <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- 昵称 -->
                <LinearLayout
                        style="@style/Widget.App.SettingsItem"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                    <TextView
                            style="@style/Widget.App.SettingsItemTitle"
                            android:text="@string/settings_nickname_label" />

                    <EditText
                            android:id="@+id/edt_nickname"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="end"
                            android:hint="@string/hint_nickname"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:textAlignment="viewEnd"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:textSize="15sp" />

                </LinearLayout>

                <View style="@style/Widget.App.InnerDivider" />

                <!-- 版本（只读） -->
                <LinearLayout
                        style="@style/Widget.App.SettingsItem"
                        android:clickable="false"
                        android:focusable="false">

                    <TextView
                            style="@style/Widget.App.SettingsItemTitle"
                            android:text="@string/settings_version_label" />

                    <TextView
                            android:id="@+id/txv_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/settings_version_value"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                    <ImageView
                            style="@style/Widget.App.SettingsItemArrow"
                            android:contentDescription="@string/settings_version_label" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 外观 ====================
             深色模式逻辑在第五步实现，届时把该分组的
             visibility 改为 visible 即可。
             ============================================= -->
        <TextView
                android:id="@+id/txvGroupAppearance"
                style="@style/TextAppearance.App.GroupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_group_appearance"
                android:visibility="gone"
                tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAppearance"
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                        style="@style/Widget.App.SettingsItem">

                    <TextView
                            style="@style/Widget.App.SettingsItemTitle"
                            android:text="@string/settings_item_dark_mode" />

                    <ImageView
                            style="@style/Widget.App.SettingsItemArrow"
                            android:contentDescription="@string/settings_item_dark_mode" />

                </LinearLayout>

                <View style="@style/Widget.App.InnerDivider" />

                <LinearLayout
                        style="@style/Widget.App.SettingsItem">

                    <TextView
                            style="@style/Widget.App.SettingsItemTitle"
                            android:text="@string/settings_item_statistics" />

                    <ImageView
                            style="@style/Widget.App.SettingsItemArrow"
                            android:contentDescription="@string/settings_item_statistics" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 日期与时间 ====================
             日期字段在第四步实现，届时把该分组的
             visibility 改为 visible 即可。
             ================================================ -->
        <TextView
                android:id="@+id/txvGroupDatetime"
                style="@style/TextAppearance.App.GroupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_group_datetime"
                android:visibility="gone"
                tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDatetime"
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                        style="@style/Widget.App.SettingsItem">

                    <TextView
                            style="@style/Widget.App.SettingsItemTitle"
                            android:text="@string/settings_item_date_format" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/settings_item_date_format_summary"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                    <ImageView
                            style="@style/Widget.App.SettingsItemArrow"
                            android:contentDescription="@string/settings_item_date_format" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 保存按钮 ==================== -->
        <Button
                android:id="@+id/btn_save_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/action_save" />

    </LinearLayout>

</ScrollView>
