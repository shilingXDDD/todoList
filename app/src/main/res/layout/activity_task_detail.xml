<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/background"
              android:orientation="vertical">

    <!-- ==================== 顶部栏：返回 + 标题 + 操作图标 ==================== -->
    <LinearLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="6dp">

        <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_task_detail"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:text="@string/title_task_detail"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        <ImageButton
                android:id="@+id/btn_toggle_complete"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/label_completed"
                android:src="@drawable/ic_check"
                app:tint="@color/text_primary" />

        <ImageButton
                android:id="@+id/btn_edit"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_edit_task"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_primary" />

        <ImageButton
                android:id="@+id/btn_test_reminder"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_sync"
                android:src="@drawable/ic_notification"
                app:tint="@color/text_primary" />

        <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/msg_delete_confirm_title"
                android:src="@drawable/ic_delete"
                app:tint="@color/delete_red" />

    </LinearLayout>

    <View style="@style/Widget.App.HeaderDivider" />

    <!-- ==================== 内容区 ==================== -->
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <!-- 状态胶囊：浅蓝底 + 深蓝字 -->
                    <TextView
                            android:id="@+id/txv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/primary_on_light"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="@string/status_pending" />

                    <!-- 标题：页面视觉重心 -->
                    <TextView
                            android:id="@+id/txv_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingExtra="6dp"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="完成 Android 课设" />

                    <!-- 分类标签（第四步） -->
                    <TextView
                            android:id="@+id/txv_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_pill_gray"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="学习" />

                    <View
                            style="@style/Widget.App.InnerDivider"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp" />

                    <!-- 描述小标题 -->
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_description"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    <!-- 描述正文 -->
                    <TextView
                            android:id="@+id/txv_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="5dp"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            tools:text="把 UI 重构成滴答清单风格" />

                    <!-- 截止日期（第四步） -->
                    <TextView
                            android:id="@+id/txv_due_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            tools:text="截止：2026-09-15 18:00" />

                    <!-- 备注（第四步） -->
                    <TextView
                            android:id="@+id/txv_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            tools:text="记得带上电脑" />

                    <!-- 链接（第四步，可点击跳转浏览器） -->
                    <TextView
                            android:id="@+id/txv_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/primary"
                            android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
