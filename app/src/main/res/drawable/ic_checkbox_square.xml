<?xml version="1.0" encoding="utf-8"?>
<!--
    勾选框 selector：
      未勾选 → 空心圆角方框
      已勾选 → 实心圆角方框
    用法：android:button="@drawable/ic_checkbox_square"
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/bg_checkbox_square_checked"/>
    <item android:drawable="@drawable/bg_checkbox_square"/>
</selector>
